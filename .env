# QueryWeaver 环境配置
# 复制自 .env.example 并根据实际需求修改配置值
#
# 最小必需配置（已取消注释）：
# - FASTAPI_SECRET_KEY  (必需)
# - FALKORDB_URL       (必需) — FalkorDB 连接字符串
#
# 可选配置（已注释）：仅在需要相关功能时取消注释并设置

# -----------------------------
# 应用 / 服务器设置
# -----------------------------
# 必需：FastAPI 会话中间件使用的密钥 — 生产环境请务必修改
FASTAPI_SECRET_KEY=dev_secret_key_change_in_production_12345678

# 可选：直接运行应用时启用调试/重载
# FASTAPI_DEBUG=False

# 可选：设置应用环境（development, staging, production）
# 默认值：development
APP_ENV=development

# Demo Graphs 使用的图名称通用前缀
# GENERAL_PREFIX=your_general_prefix_here

# 可选：开发环境允许 HTTP OAuth（生产环境请禁用）
OAUTHLIB_INSECURE_TRANSPORT=1

# -----------------------------
# FalkorDB 连接 (必需 / 推荐)
# -----------------------------
# 推荐：单一连接 URL。修改为指向你的 FalkorDB/Redis 实例
# 示例：redis://localhost:6379/0
FALKORDB_URL=redis://localhost:36379/0  # 必需 - 修改为你的 FalkorDB URL

# 可选：用于本地测试的独立主机/端口设置（仅在未设置 FALKORDB_URL 时使用）
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379

# -----------------------------
# 可选 API / 密钥令牌
# -----------------------------
# 内部 API 访问令牌（可选）
# SECRET_TOKEN=your_secret_token
# SECRET_TOKEN_ERP=your_erp_token

# -----------------------------
# AI / LLM 配置（可选）
# -----------------------------
# QueryWeaver 支持三种 LLM 提供商：Azure OpenAI、OpenAI 和 DeepSeek
# 配置优先级：用户配置（Web UI）> 环境变量 > 系统默认值

# 选项 1：Azure OpenAI（如果设置了所有三个变量则为默认）
# AZURE_API_KEY=your_azure_api_key
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2023-05-15

# 选项 2：OpenAI（直接 API）
# OPENAI_API_KEY=your_openai_api_key

# 选项 3：DeepSeek（性价比高的中文 LLM，比 OpenAI 便宜 90%）
# 获取 API Key: https://platform.deepseek.com/
# 1. 注册账号（支持中国手机号）
# 2. 进入 API Keys 页面
# 3. 创建新的 API Key
# 4. 复制 API Key（以 sk- 开头）
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com  # 可选，未设置时使用默认值
# DEEPSEEK_COMPLETION_MODEL=deepseek-chat      # 可选：deepseek-chat 或 deepseek-coder
# DEEPSEEK_EMBEDDING_MODEL=text-embedding-ada-002  # 可选：嵌入模型

# 用于安全存储 API 密钥的加密密钥（使用 Web UI 配置时）
# 生产环境请生成安全的 32 字节 base64 编码密钥
# 示例：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 如果未设置，将生成默认密钥（生产环境不推荐）
# LLM_CONFIG_ENCRYPTION_KEY=your-32-byte-base64-encoded-key

# 可选：覆盖 api/config.py 中的默认模型名称
# COMPLETION_MODEL=azure/gpt-4.1
# EMBEDDING_MODEL=azure/text-embedding-ada-002

# -----------------------------
# OAuth 配置（可选 — 取消注释以启用登录流程）
# -----------------------------
# Google OAuth
#GOOGLE_CLIENT_ID=your_google_client_id
#GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# WeChat OAuth（微信登录）
# 配置说明：
# 1. 在微信开放平台 (https://open.weixin.qq.com/) 创建网站应用
# 2. 配置授权回调域名为你的应用域名
# 3. 获取 AppID 和 AppSecret
# 4. 注意：需要已备案的域名才能使用微信登录
WECHAT_APP_ID=wx1234567890abcdef
WECHAT_APP_SECRET=your_wechat_app_secret

# WeCom OAuth（企业微信登录）
# 配置说明：
# 1. 在企业微信管理后台 (https://work.weixin.qq.com/) 创建自建应用
# 2. 配置可信域名为你的应用域名
# 3. 获取 CorpID（企业ID）、AgentID（应用ID）和 CorpSecret（应用密钥）
# 4. 在应用管理中设置"网页授权及JS-SDK"的可信域名
WECOM_CORP_ID=ww1234567890abcdef
WECOM_AGENT_ID=1000001
WECOM_CORP_SECRET=your_wecom_corp_secret

# 如果你的 OAuth 应用使用的基础 URL 与请求基础不同（例如，使用 127.0.0.1 vs localhost）
# 可以覆盖用于构建回调 URL 的基础。示例：
# OAUTH_BASE_URL=http://localhost:5000

# -----------------------------
# 邮件配置（可选 - 用于发送邀请邮件）
# -----------------------------
# MAIL_SERVER=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your_mail_username
# MAIL_PASSWORD=your_mail_password
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com
# EMAIL_AUTH_ENABLED=false

# -----------------------------
# HTTP 连接池设置（可选）
# -----------------------------
# 连接池配置用于复用 HTTP 连接，减少网络开销
# 这些设置影响 LiteLLM 和其他 HTTP 客户端的连接管理

# HTTP 连接池大小（最大并发连接数）
# 默认值：100
# HTTP_POOL_SIZE=100

# 超出连接池大小时的额外连接数
# 默认值：10
# HTTP_MAX_OVERFLOW=10

# HTTP 请求超时时间（秒）
# 默认值：30.0
# HTTP_TIMEOUT=30.0

# Keep-Alive 连接超时时间（秒）
# 默认值：30.0
# HTTP_KEEPALIVE_TIMEOUT=30.0

# HTTP 代理设置（可选）
# 如果需要通过代理访问外部 API，配置以下变量
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8443

# -----------------------------
# 记忆 TTL（可选）
# -----------------------------
# MEMORY_TTL_SECONDS=604800

# -----------------------------
# MCP 配置（可选）
# -----------------------------
DISABLE_MCP=false
